---
type ViewKey = "manifesto" | "policy" | "contact";

interface Props {
  currentView: ViewKey;
  description: string;
  heroTitle: string;
  meta?: string[];
  title: string;
}

const { currentView, description, heroTitle, meta = [], title } = Astro.props;

const navItems = [
  { key: "manifesto", href: "/", label: "Manifesto" },
  { key: "policy", href: "/policy", label: "Policy" },
  { key: "contact", href: "/contact", label: "Contact" },
] as const;

const currentLabel = navItems.find((item) => item.key === currentView)?.label ?? heroTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #ffffff;
        --ink: #1a1a1a;
        --muted: #666666;
        --border: #eeeeee;
        --border-strong: #d8d8d8;
        --max-width: 640px;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-serif: "Instrument Serif", serif;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        overflow-x: hidden;
        overflow-y: scroll;
        background: var(--bg);
      }

      body {
        max-width: var(--max-width);
        min-height: 100vh;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
        background: var(--bg);
      }

      a {
        color: inherit;
        overflow-wrap: break-word;
        word-break: break-word;
      }

      strong {
        font-weight: 600;
      }

      .page {
        display: grid;
        gap: 1.5rem;
      }

      .site-header {
        display: grid;
        gap: 0.45rem;
      }

      .brand {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(2.4rem, 8vw, 3.35rem);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 0.94;
      }

      .brand a {
        text-decoration: none;
      }

      .site-copy {
        max-width: 41ch;
        color: var(--muted);
        text-wrap: pretty;
      }

      .main-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem 1rem;
      }

      .main-nav a {
        padding-bottom: 0.25rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-decoration: none;
      }

      .main-nav a:hover {
        color: var(--ink);
      }

      .main-nav a[aria-current="page"] {
        color: var(--ink);
        border-bottom: 2px solid var(--ink);
      }

      .rule {
        height: 1px;
        background: var(--border);
      }

      .hero {
        display: grid;
        gap: 0.85rem;
      }

      .eyebrow,
      .meta,
      .section-label,
      .policy-number,
      .policy-callout,
      .link-note {
        font-family: var(--font-mono);
      }

      .eyebrow,
      .section-label,
      .policy-number {
        color: var(--muted);
        font-size: 0.74rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .title {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(3rem, 10vw, 4.8rem);
        font-weight: 400;
        letter-spacing: -0.035em;
        line-height: 0.9;
        text-wrap: balance;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        color: var(--muted);
        font-size: 0.78rem;
      }

      .document {
        display: grid;
        gap: 2.75rem;
      }

      .doc-section {
        display: grid;
        gap: 1.35rem;
      }

      .doc-section + .doc-section {
        padding-top: 2rem;
        border-top: 1px solid var(--border);
      }

      .section-head {
        display: grid;
        gap: 0.5rem;
      }

      .section-title,
      .policy-title {
        margin: 0;
        font-family: var(--font-serif);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.02;
        text-wrap: balance;
      }

      .section-title {
        font-size: clamp(2rem, 5vw, 2.7rem);
      }

      .section-copy,
      .policy-text,
      .footer-copy {
        max-width: 40ch;
        font-size: 1rem;
        line-height: 1.75;
        text-wrap: pretty;
      }

      .body {
        display: grid;
        gap: 1.35rem;
      }

      .stanza {
        max-width: 40ch;
        font-size: clamp(1.02rem, 2vw, 1.08rem);
        line-height: 1.85;
        text-wrap: pretty;
      }

      .dropcap {
        float: left;
        margin: 0.08em 0.4rem 0 0;
        font-family: var(--font-serif);
        font-size: 3.2rem;
        font-style: italic;
        line-height: 0.8;
      }

      .policy-sections {
        list-style: none;
        display: grid;
        gap: 1.6rem;
      }

      .policy-section {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }

      .policy-section:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .policy-body {
        display: grid;
        gap: 0.8rem;
      }

      .policy-title {
        font-size: clamp(1.65rem, 4vw, 2rem);
      }

      .policy-list,
      .policy-sublist,
      .join-list {
        max-width: 40ch;
        margin: 0;
        padding-left: 1.2em;
        font-size: 1rem;
        line-height: 1.75;
      }

      .policy-list li + li,
      .policy-sublist li + li,
      .join-list li + li {
        margin-top: 0.35rem;
      }

      .policy-sublist {
        margin-top: 0.45rem;
      }

      .policy-callout {
        max-width: 40ch;
        padding-left: 1rem;
        border-left: 2px solid var(--border-strong);
        color: #555555;
        font-size: 0.73rem;
        letter-spacing: 0.08em;
        line-height: 1.8;
        text-transform: uppercase;
      }

      .join-panel {
        display: grid;
        gap: 1rem;
      }

      .footer-copy {
        font-size: clamp(1.05rem, 2.2vw, 1.14rem);
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 1rem;
        align-items: center;
      }

      .cta {
        display: inline-block;
        padding: 0.4rem 0.75rem;
        background: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        box-shadow: 0 2px 0 #c0c0c0;
        color: #333333;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
      }

      .cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 0 #c0c0c0;
      }

      .cta:active {
        transform: translateY(2px);
        box-shadow: 0 0 0 #c0c0c0;
      }

      .link-note {
        max-width: 32ch;
        color: var(--muted);
        font-size: 0.74rem;
        line-height: 1.6;
      }

      @media (max-width: 720px) {
        body {
          padding: 1.5rem 1rem 3rem;
        }

        .title {
          font-size: clamp(2.7rem, 15vw, 4rem);
        }

        .stanza,
        .section-copy,
        .policy-text,
        .policy-list,
        .policy-sublist,
        .join-list,
        .footer-copy,
        .policy-callout {
          max-width: none;
        }

        .policy-section {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="site-header">
        <h1 class="brand"><a href="/">Modern Faber</a></h1>
        <p class="site-copy">
          A weekly standard for builders who care about shipped work, visible proof, and showing
          up every week.
        </p>
      </header>

      <nav class="main-nav" aria-label="Page navigation">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={currentView === item.key ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="rule" aria-hidden="true"></div>

      <article class="document">
        <header class="hero">
          <p class="eyebrow">{currentLabel}</p>
          <h2 class="title">{heroTitle}</h2>
          {meta.length > 0 && (
            <div class="meta">
              {meta.map((item) => <span>{item}</span>)}
            </div>
          )}
        </header>

        <slot />
      </article>
    </main>
  </body>
</html>
