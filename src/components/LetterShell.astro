---
type ViewKey = "manifesto" | "policy" | "contact";

interface Props {
  currentView: ViewKey;
  description: string;
  heroTitle: string;
  meta?: string[];
  title: string;
}

const { currentView, description, heroTitle, meta = [], title } = Astro.props;

const navItems = [
  { key: "manifesto", href: "/", label: "Manifesto" },
  { key: "policy", href: "/policy", label: "Policy" },
  { key: "contact", href: "/contact", label: "Contact" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap");

      :root {
        --bg: #ffffff;
        --ink: #111111;
        --muted: #6b6b6b;
        --rule: #e8e8e8;
      }

      * {
        box-sizing: border-box;
      }

      html {
        color-scheme: light;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: "Newsreader", Georgia, serif;
        background: var(--bg);
      }

      .page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(24px, 4vw, 56px) clamp(24px, 4vw, 56px) 116px;
      }

      .letter {
        width: min(100%, 760px);
      }

      .header {
        display: grid;
        gap: 14px;
        margin-bottom: 30px;
      }

      .eyebrow,
      .meta,
      .link-note,
      .section-label,
      .policy-number {
        font-family: "IBM Plex Mono", monospace;
      }

      .eyebrow {
        margin: 0;
        color: var(--muted);
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .title {
        margin: 0;
        max-width: 9ch;
        font-size: clamp(3rem, 9vw, 5rem);
        line-height: 0.9;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .rule {
        height: 1px;
        margin: 0 0 18px;
        background: var(--rule);
      }

      .document {
        display: grid;
        gap: 54px;
      }

      .doc-section {
        display: grid;
        gap: 26px;
      }

      .doc-section + .doc-section {
        padding-top: 44px;
        border-top: 1px solid var(--rule);
      }

      .section-head {
        display: grid;
        gap: 10px;
      }

      .section-label {
        margin: 0;
        color: var(--muted);
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }

      .section-title {
        margin: 0;
        max-width: 12ch;
        font-size: clamp(2.3rem, 6vw, 3.7rem);
        line-height: 0.94;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .section-copy {
        margin: 0;
        max-width: 34ch;
        color: var(--ink);
        font-size: clamp(1.12rem, 2vw, 1.28rem);
        line-height: 1.5;
        text-wrap: pretty;
      }

      .body {
        display: grid;
        gap: 28px;
      }

      .stanza {
        margin: 0;
        max-width: 38ch;
        font-size: clamp(1.28rem, 2.4vw, 1.66rem);
        line-height: 1.6;
        text-wrap: pretty;
      }

      .dropcap {
        float: left;
        padding-top: 6px;
        padding-right: 10px;
        font-size: 4rem;
        line-height: 0.78;
        font-weight: 600;
      }

      .policy-sections {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 24px;
      }

      .policy-section {
        display: grid;
        grid-template-columns: 64px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        padding-top: 18px;
        border-top: 1px solid rgba(98, 73, 48, 0.14);
      }

      .policy-section:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .policy-number {
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .policy-body {
        display: grid;
        gap: 12px;
      }

      .policy-title {
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 1.9rem);
        line-height: 1.05;
        font-weight: 600;
      }

      .policy-text {
        margin: 0;
        max-width: 38ch;
        font-size: clamp(1.12rem, 2vw, 1.28rem);
        line-height: 1.55;
        text-wrap: pretty;
      }

      .policy-list,
      .policy-sublist,
      .join-list {
        margin: 0;
        padding-left: 1.15em;
        max-width: 40ch;
        font-size: clamp(1.08rem, 1.9vw, 1.22rem);
        line-height: 1.58;
      }

      .policy-list,
      .policy-sublist {
        display: grid;
        gap: 8px;
      }

      .policy-sublist {
        padding-left: 1.05em;
      }

      .policy-callout {
        margin: 0;
        max-width: 33ch;
        padding: 0 0 0 14px;
        border-left: 1px solid var(--rule);
        background: transparent;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        line-height: 1.75;
        text-transform: uppercase;
      }

      .join-panel {
        display: grid;
        gap: 22px;
      }

      .footer-copy {
        margin: 0;
        max-width: 29ch;
        font-size: clamp(1.22rem, 2.3vw, 1.55rem);
        line-height: 1.5;
        text-wrap: pretty;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 176px;
        min-height: 54px;
        padding: 14px 22px;
        border: 1px solid var(--ink);
        border-radius: 999px;
        background: var(--bg);
        color: var(--ink);
        text-decoration: none;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition: background 160ms ease, color 160ms ease;
      }

      .cta:hover,
      .cta:focus-visible {
        background: var(--ink);
        color: var(--bg);
      }

      .cta:focus-visible {
        outline: 2px solid rgba(122, 74, 38, 0.22);
        outline-offset: 4px;
      }

      .link-note {
        margin: 0;
        max-width: 29ch;
        color: var(--muted);
        font-size: 0.74rem;
        line-height: 1.6;
      }

      .bottom-nav {
        position: fixed;
        left: 50%;
        bottom: 18px;
        z-index: 20;
        width: min(calc(100vw - 32px), 420px);
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: var(--bg);
        transform: translateX(-50%);
      }

      .tab-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1 1 0;
        min-width: 0;
        padding: 12px 16px;
        border: 1px solid transparent;
        border-radius: 999px;
        background: transparent;
        color: var(--muted);
        text-decoration: none;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition:
          transform 180ms ease,
          background 180ms ease,
          color 180ms ease,
          border-color 180ms ease;
      }

      .tab-link:hover,
      .tab-link:focus-visible {
        background: #f5f5f5;
        color: var(--ink);
        border-color: var(--rule);
      }

      .tab-link:focus-visible {
        outline: 2px solid rgba(122, 74, 38, 0.22);
        outline-offset: 4px;
      }

      .tab-link.is-current,
      .tab-link[aria-current="page"] {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
      }

      @media (max-width: 720px) {
        .page {
          padding: 22px 20px 108px;
        }

        .title {
          max-width: none;
          font-size: clamp(2.7rem, 15vw, 4rem);
        }

        .document {
          gap: 42px;
        }

        .doc-section + .doc-section {
          padding-top: 34px;
        }

        .section-title {
          max-width: none;
          font-size: clamp(2rem, 10vw, 3rem);
        }

        .stanza,
        .footer-copy,
        .section-copy,
        .policy-text,
        .policy-list,
        .policy-sublist,
        .join-list {
          max-width: none;
        }

        .stanza {
          font-size: clamp(1.18rem, 5.2vw, 1.42rem);
        }

        .policy-section {
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .tab-link {
          flex-basis: calc(33.333% - 6px);
        }

        .dropcap {
          padding-top: 2px;
          padding-right: 8px;
          font-size: 3.6rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <article class="letter">
        <header class="header">
          <p class="eyebrow">Modern Faber</p>
          <h1 class="title">{heroTitle}</h1>
          {meta.length > 0 && (
            <div class="meta">
              {meta.map((item) => <span>{item}</span>)}
            </div>
          )}
        </header>

        <div class="rule" aria-hidden="true"></div>

        <div class="document">
          <slot />
        </div>
      </article>
    </main>

    <nav class="bottom-nav" aria-label="Page navigation">
      {
        navItems.map((item) => (
          <a
            class:list={["tab-link", currentView === item.key && "is-current"]}
            href={item.href}
            aria-current={currentView === item.key ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </body>
</html>
