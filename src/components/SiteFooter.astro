---
import { inquiryEmailAddress, inquiryEmailUrl, siteName } from "../lib/site";
---

<footer class="site-footer" aria-label="Site footer">
  <div class="site-footer__rule" aria-hidden="true"></div>
  <div class="site-footer__content">
    <p class="site-footer__brand">{siteName}</p>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href={inquiryEmailUrl}>Email {inquiryEmailAddress}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: 0.9rem;
    padding-top: 0.25rem;
  }

  .site-footer__rule {
    height: 1px;
    background: #e9e9e9;
  }

  .site-footer__content {
    display: grid;
    gap: 0.5rem;
  }

  .site-footer__brand,
  .site-footer__nav {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.05em;
  }

  .site-footer__brand {
    color: #666666;
    text-transform: uppercase;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
  }

  .site-footer__nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
