<span class="signature-lockup" aria-hidden="true" data-signature data-signature-state="static">
  <svg
    class="signature-svg"
    viewBox="-83 -633 4394 737"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMinYMid meet"
    focusable="false"
  >
    <path class="signature-fill" d={signaturePath}></path>
    <g class="signature-shadow" aria-hidden="true">
      {
        signatureSegments.map((segment, index) => (
          <path d={segment} data-signature-shadow data-signature-index={index}></path>
        ))
      }
    </g>
    <g class="signature-stroke" aria-hidden="true">
      {
        signatureSegments.map((segment, index) => (
          <path d={segment} data-signature-stroke data-signature-index={index}></path>
        ))
      }
    </g>
  </svg>
</span>

<style>
  .signature-lockup {
    display: block;
    width: min(100%, 18.75rem);
    color: currentColor;
    transform-origin: left bottom;
  }

  .signature-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .signature-fill {
    fill: currentColor;
    opacity: 1;
    transition: opacity 0.42s ease;
  }

  .signature-shadow path,
  .signature-stroke path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    will-change: stroke-dashoffset, opacity;
  }

  .signature-shadow path {
    stroke-width: 4.75;
    filter: blur(4px);
  }

  .signature-stroke path {
    stroke-width: 2.15;
  }

  .signature-lockup[data-signature-state="idle"] {
    opacity: 0;
    transform: translateY(0.65rem) rotate(-0.8deg) scale(0.985);
    filter: blur(0.75px);
  }

  .signature-lockup[data-signature-state="drawing"],
  .signature-lockup[data-signature-state="drawn"] {
    opacity: 1;
    transform: translateY(0) rotate(0deg) scale(1);
    filter: blur(0);
  }

  .signature-lockup[data-signature-state="idle"],
  .signature-lockup[data-signature-state="drawing"] {
    transition:
      opacity 0.36s ease,
      transform 0.8s cubic-bezier(0.2, 0.9, 0.2, 1),
      filter 0.36s ease;
  }

  .signature-lockup[data-signature-state="idle"] .signature-fill,
  .signature-lockup[data-signature-state="drawing"] .signature-fill {
    opacity: 0;
  }

  .signature-lockup[data-signature-state="drawn"] .signature-fill {
    opacity: 1;
  }

  .signature-lockup[data-signature-state="drawn"] .signature-shadow,
  .signature-lockup[data-signature-state="drawn"] .signature-stroke {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-fill {
      opacity: 1;
    }

    .signature-shadow,
    .signature-stroke,
    .signature-lockup {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .signature-shadow,
    .signature-stroke {
      display: none;
    }
  }
</style>

<script>
  const signatures = document.querySelectorAll("[data-signature]");

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  const prepareSignature = (signature) => {
    const strokePaths = Array.from(signature.querySelectorAll("[data-signature-stroke]"));
    const shadowPaths = Array.from(signature.querySelectorAll("[data-signature-shadow]"));

    const metrics = strokePaths.map((path, index) => {
      const shadow = shadowPaths[index];
      const length = path.getTotalLength();
      const box = path.getBBox();

      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.opacity = "0";

      shadow.style.strokeDasharray = `${length}`;
      shadow.style.strokeDashoffset = `${length}`;
      shadow.style.opacity = "0";

      return { box, length, path, shadow };
    });

    return { metrics, shadowPaths, strokePaths };
  };

  const getPause = (currentBox, previousBox) => {
    if (!previousBox) {
      return 0;
    }

    const horizontalGap = currentBox.x - (previousBox.x + previousBox.width);

    if (horizontalGap <= 8) {
      return 18;
    }

    if (horizontalGap <= 36) {
      return 34;
    }

    return clamp(42 + horizontalGap * 0.2, 42, 120);
  };

  const playSignature = (signature, prepared) => {
    const { metrics, shadowPaths, strokePaths } = prepared;

    if (metrics.length === 0 || signature.dataset.signaturePlayed === "true") {
      return;
    }

    signature.dataset.signaturePlayed = "true";
    signature.dataset.signatureState = "drawing";

    const totalLength = metrics.reduce((sum, metric) => sum + metric.length, 0);
    const lengthPerMillisecond = totalLength / 2350;

    let cursor = 70;

    metrics.forEach((metric, index) => {
      const previousMetric = metrics[index - 1];
      const pause = getPause(metric.box, previousMetric?.box);
      const jitter = [1.06, 0.96, 1.02, 0.92][index % 4];
      const duration = clamp(metric.length / lengthPerMillisecond, 90, 340) * jitter;
      const delay = Math.round(cursor + pause);

      metric.path.style.transition = [
        `stroke-dashoffset ${duration}ms cubic-bezier(0.35, 0.05, 0.18, 1) ${delay}ms`,
        `opacity 120ms linear ${delay}ms`,
      ].join(", ");

      metric.shadow.style.transition = [
        `stroke-dashoffset ${duration}ms cubic-bezier(0.35, 0.05, 0.18, 1) ${delay}ms`,
        `opacity 170ms ease ${delay}ms`,
      ].join(", ");

      metric.path.style.opacity = "1";
      metric.path.style.strokeDashoffset = "0";

      metric.shadow.style.opacity = "0.16";
      metric.shadow.style.strokeDashoffset = "0";

      cursor = delay + duration;
    });

    window.setTimeout(() => {
      signature.dataset.signatureState = "drawn";
    }, Math.round(cursor + 170));

    window.setTimeout(() => {
      strokePaths.forEach((path) => {
        path.style.opacity = "0";
      });

      shadowPaths.forEach((path) => {
        path.style.opacity = "0";
      });
    }, Math.round(cursor + 60));
  };

  if (signatures.length > 0) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    signatures.forEach((signature) => {
      if (reducedMotion.matches) {
        signature.dataset.signatureState = "drawn";
        signature.dataset.signaturePlayed = "true";
        return;
      }

      const prepared = prepareSignature(signature);
      signature.dataset.signatureState = "idle";

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            playSignature(signature, prepared);
            observer.unobserve(signature);
          });
        },
        {
          threshold: 0.55,
          rootMargin: "0px 0px -10% 0px",
        },
      );

      observer.observe(signature);
    });
  }
</script>
