// Give every nib the same pen speed: time each one by its own length, so a long
// sweep takes longer than a tick. Short strokes get a floor so they do not pop.
const SIGNATURE_START = 0.35;
const SIGNATURE_DRAW_SECONDS = 2.4;
const SIGNATURE_LIFT = 0.02;

const nibLength = (d) => {
  const points = d.slice(1).split("L").map((p) => p.split(" ").map(Number));
  return points.reduce(
    (total, [x, y], i) =>
      i === 0 ? total : total + Math.hypot(x - points[i - 1][0], y - points[i - 1][1]),
    0
  );
};

const nibLengths = signatureNibs.map(nibLength);
const nibTotal = nibLengths.reduce((a, b) => a + b, 0);

let penDownAt = SIGNATURE_START;
const signatureTiming = nibLengths.map((length) => {
  const duration = Math.max(0.06, (length / nibTotal) * SIGNATURE_DRAW_SECONDS);
  const delay = penDownAt;
  penDownAt += duration + SIGNATURE_LIFT;
  return `animation-delay:${delay.toFixed(3)}s;animation-duration:${duration.toFixed(3)}s`;
});
