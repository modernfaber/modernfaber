---
const frames = [
  {
    src: "/images/remarkable.png",
    alt: "reMarkable tablet with folio and stylus"
  },
  {
    src: "/images/macintosh-128k.png",
    alt: "Original Macintosh 128K computer"
  },
  {
    src: "/images/montblanc-pen.png",
    alt: "Black and gold Montblanc fountain pen"
  },
  {
    src: "/images/porsche-911-gt2-rs.png",
    alt: "Silver Porsche 911 GT2 RS side view"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modern Faber</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap");

      :root {
        --background: #ffffff;
        --text: #111111;
        --button: #111111;
        --button-text: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--background);
        color: var(--text);
        font-family: "IBM Plex Mono", monospace;
      }

      .page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px 16px;
      }

      .shell {
        width: min(100%, 340px);
        display: grid;
        gap: 16px;
        justify-items: center;
        text-align: center;
      }

      .headline {
        margin: 0;
        font-size: clamp(1rem, 2.5vw, 1.625rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.06em;
      }

      .frame {
        margin: 0;
        width: min(100%, 260px);
        min-height: clamp(130px, 25vh, 210px);
        display: grid;
        place-items: center;
      }

      .frame img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: clamp(120px, 23vh, 190px);
        object-fit: contain;
        transition: opacity 180ms ease, transform 180ms ease;
      }

      .frame img.is-fading {
        opacity: 0.2;
        transform: scale(0.985);
      }

      .enter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 96px;
        min-height: 36px;
        padding: 10px 18px;
        border: 1px solid var(--button);
        background: var(--button);
        color: var(--button-text);
        text-decoration: none;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition: background 180ms ease, color 180ms ease;
      }

      .enter:hover,
      .enter:focus-visible {
        background: #ffffff;
        color: #111111;
      }

      .enter:focus-visible {
        outline: 2px solid rgba(17, 17, 17, 0.3);
        outline-offset: 4px;
      }

      @media (max-width: 480px) {
        .frame {
          width: 100%;
        }

        .enter {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="shell">
        <h1 class="headline">If you love ...</h1>
        <figure class="frame">
          <img
            id="rotating-image"
            src={frames[0].src}
            alt={frames[0].alt}
            width="720"
            height="960"
          />
        </figure>
        <a class="enter" href="/enter">Join</a>
      </section>
    </main>

    <script is:inline define:vars={{ frames }}>
      const image = document.getElementById("rotating-image");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (image && !reduceMotion.matches) {
        let currentIndex = 0;

        window.setInterval(() => {
          currentIndex = (currentIndex + 1) % frames.length;
          image.classList.add("is-fading");

          window.setTimeout(() => {
            const nextFrame = frames[currentIndex];

            image.src = nextFrame.src;
            image.alt = nextFrame.alt;
            image.classList.remove("is-fading");
          }, 180);
        }, 2600);
      }
    </script>
  </body>
</html>
