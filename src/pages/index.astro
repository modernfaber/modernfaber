---
import { inquiryEmailAddress, inquiryEmailUrl, siteName } from "../lib/site";

const title = "Modern Faber";
const description =
  "Modern Faber is a high-trust, high-signal community built around rich, small-table meetups.";

// Drawn in pen order: M, the connected "odern", the F stem, its crossbar, the
// connected "aber", then the exit flourish. Rendered twice — once as the ghost
// indent, once as the ink.
const signatureStrokes = [
  "M 16 58 C 18 44 22 28 28 22 C 33 18 33 32 32 42 C 31 50 31 55 32 58 C 34 44 40 26 46 21 C 51 18 50 32 49 42 C 48 50 48 55 49 58 C 51 50 55 44 60 42",
  "M 60 44 C 62 36 70 32 76 36 C 82 40 81 53 74 56 C 66 59 60 51 63 44 C 66 39 72 38 78 40 C 84 38 90 38 92 42 C 89 36 80 39 79 47 C 78 55 87 61 93 55 C 95 52 96 46 96 42 C 97 32 98 22 99 16 C 100 26 98 44 97 54 C 98 51 102 49 106 49 C 110 47 116 42 113 39 C 110 36 105 41 106 47 C 108 55 116 59 122 54 C 124 52 125 51 127 50 C 130 44 133 38 135 41 C 137 44 140 42 143 41 C 141 45 140 52 140 58 C 141 52 144 48 148 47 C 149 44 150 50 150 58 C 150 48 154 40 159 41 C 163 42 162 52 162 58 C 163 52 167 48 172 47",
  "M 230 12 C 218 9 207 12 205 22 C 202 34 199 46 197 60",
  "M 190 41 C 200 38 211 37 221 36",
  "M 244 42 C 240 36 231 37 230 46 C 229 55 238 61 243 55 C 245 52 245 46 244 42 C 244 50 244 55 245 58 C 246 54 249 50 253 49 C 257 46 261 30 263 18 C 264 28 261 46 260 55 C 262 49 269 47 272 51 C 275 55 270 60 264 57 C 268 56 272 53 275 51 C 279 49 285 44 282 40 C 279 37 274 42 275 48 C 277 56 285 60 291 55 C 293 53 294 52 296 51 C 299 45 302 39 304 42 C 306 45 309 43 312 42 C 310 46 309 53 309 58 C 310 53 313 49 317 48",
  "M 317 48 C 328 51 344 49 356 41",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Xanh+Mono:ital@0;1&display=swap"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: #f7f7f8;
      }

      body {
        min-height: 100vh;
        padding: 40px;
        color: #111111;
        background: #f7f7f8;
        font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Monaco, "Cascadia Mono",
          Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        line-height: 20px;
      }

      main {
        display: grid;
        gap: 20px;
        justify-items: start;
      }

      .letter,
      .model,
      .members {
        display: grid;
        gap: 20px;
      }

      .member-list {
        list-style: disc;
        padding-left: 2ch;
      }

      .para {
        max-width: 72ch;
      }

      .sep,
      h1,
      .label {
        font-size: inherit;
        font-weight: 400;
      }

      h1,
      .label {
        font-family: "Xanh Mono", ui-monospace, Menlo, monospace;
        font-size: 15px;
        letter-spacing: 0.04em;
      }

      a {
        color: #0000ee;
      }

      a:visited {
        color: #551a8b;
      }

      .cursor {
        animation: blink 1s step-end infinite;
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      .signature {
        width: 280px;
        max-width: 100%;
        height: auto;
        margin-top: 20px;
        overflow: visible;
      }

      .signature path {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        /* Hidden until its turn, else the round cap leaves a dot on the page. */
        visibility: hidden;
        animation: draw 0.7s cubic-bezier(0.5, 0, 0.3, 1) forwards;
      }

      .sig-ink path {
        stroke: #111111;
        stroke-width: 2.2;
      }

      /* Sits a hair below the ink so each stroke leaves an indent behind it. */
      .sig-ghost {
        transform: translate(0.5px, 1.4px);
      }

      .sig-ghost path {
        stroke: #dcdce0;
        stroke-width: 3.2;
      }

      .signature path:nth-child(1) {
        animation-delay: 0.3s;
      }

      .signature path:nth-child(2) {
        animation-delay: 0.95s;
        animation-duration: 1.05s;
      }

      .signature path:nth-child(3) {
        animation-delay: 1.95s;
        animation-duration: 0.45s;
      }

      .signature path:nth-child(4) {
        animation-delay: 2.35s;
        animation-duration: 0.28s;
      }

      .signature path:nth-child(5) {
        animation-delay: 2.6s;
        animation-duration: 1.05s;
      }

      .signature path:nth-child(6) {
        animation-delay: 3.6s;
        animation-duration: 0.4s;
      }

      @keyframes draw {
        from {
          stroke-dashoffset: 1;
          visibility: visible;
        }

        to {
          stroke-dashoffset: 0;
          visibility: visible;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .cursor {
          animation: none;
        }

        .signature path {
          animation: none;
          stroke-dashoffset: 0;
          visibility: visible;
        }
      }

      @media (max-width: 600px) {
        body {
          padding: 20px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>MODERN FABER <span class="cursor" aria-hidden="true">_</span></h1>

      <p class="sep" aria-hidden="true">* * *</p>

      <section class="letter" aria-label="To the fabers">
        <p class="label">TO THE FABERS:</p>
        <p class="para">
          Faber is an old word for a maker &mdash; the smith at the forge, the carpenter at the
          bench, the hand that shapes raw material into something that did not exist before.
          <em>Homo faber</em>: the one who makes. There have never been fewer. Not because people
          stopped wanting to make things, but because talking about making became easier than
          making &mdash; the feed rewards the announcement, not the object, and whole rooms fill
          with people circling the work they say they want to do.
        </p>
        <p class="para">
          Modern Faber is a room for the ones who still make. One rule holds it together: come
          back every week with something real, and say what you changed. There is no audience
          here, no applause &mdash; only other fabers paying attention to the details you almost
          skipped. That attention costs something. It is meant to. Keep the rhythm long enough
          and you are left with a body of work, a sharper eye, and the few people you actually
          want beside you at the bench.
        </p>
      </section>

      <p class="sep" aria-hidden="true">* * *</p>

      <section class="model" aria-labelledby="model-heading">
        <p class="label" id="model-heading">HOW WE OPERATE:</p>
        <p class="para">
          <strong>HIGH TRUST, HIGH SIGNAL COMMUNITY.</strong> The commons is open to anyone with
          a serious question. The member room is not &mdash; you get in on the work you share and
          the answers you give, and no one gets in without at least five members agreeing to it.
          Titles count for nothing here. The work counts for everything.
        </p>
        <p class="para">
          <strong>RICH, DENSE MEETUPS.</strong> Three or four people to a table, never more.
          Tables are matched at random &mdash; seven signups become one table of three and one of
          four. Every conversation should be dense enough that each person leaves holding
          something they could not have reached alone.
        </p>
      </section>

      <p class="sep" aria-hidden="true">* * *</p>

      <section class="members" aria-labelledby="members-heading">
        <p class="label" id="members-heading">MEMBERS:</p>
        <ul class="member-list">
          <li class="para">
            John J. &mdash; Co-founder at
            <a href="https://fastrepl.com/">Fastrepl</a> (YC S25).
          </li>
          <li class="para">
            Chanhee L. &mdash; Co-founder at
            <a href="https://aside.com/">Aside</a> (YC F25).
          </li>
          <li class="para">
            Jay S. &mdash; Research engineer at
            <a href="https://www.cartesia.ai/">Cartesia AI</a>; formerly co-founded
            <a href="https://nari-labs.com/">Nari Labs</a> (YC F25).
          </li>
          <li class="para">
            Sunghyun C. &mdash; Research engineer at
            <a href="https://www.twelvelabs.io/">Twelve Labs</a>.
          </li>
          <li class="para">
            <strong>You?</strong> &mdash; Email your best work to
            <a href={inquiryEmailUrl}>{inquiryEmailAddress}</a> and say why you want in.
          </li>
        </ul>
      </section>

      <svg class="signature" viewBox="0 0 372 84" role="img" aria-label="Signed, Modern Faber">
        <g class="sig-ghost" aria-hidden="true">
          {signatureStrokes.map((d) => <path d={d} pathLength="1" />)}
        </g>
        <g class="sig-ink">
          {signatureStrokes.map((d) => <path d={d} pathLength="1" />)}
        </g>
      </svg>
    </main>
  </body>
</html>
