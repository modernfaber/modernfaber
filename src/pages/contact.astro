---
import SiteFooter from "../components/SiteFooter.astro";

const destination = "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Redirecting | Modern Faber</title>
    <link rel="canonical" href={destination} />
    <style>
      :root {
        --bg: #ffffff;
        --ink: #1a1a1a;
        --muted: #666666;
        --max-width: 540px;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0 auto;
        max-width: var(--max-width);
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
        background: var(--bg);
      }

      main {
        display: grid;
        gap: 1.25rem;
      }

      p {
        margin: 0;
        color: var(--muted);
      }

      a {
        color: inherit;
      }

      a[href],
      button,
      summary,
      [role="button"],
      [role="link"],
      input[type="button"],
      input[type="submit"],
      input[type="reset"],
      label[for] {
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <main>
      <p>
        Redirecting <a href={destination}>home</a>.
      </p>
      <SiteFooter />
    </main>
  </body>
</html>
