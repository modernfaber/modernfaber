---
const destination = "/join";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Redirecting to Join | Modern Faber</title>
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>Join</a>.
    </p>
  </body>
</html>
