---
const destination = "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f7f8" />
    <title>Redirecting | Modern Faber</title>
    <link rel="canonical" href={destination} />
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: #f7f7f8;
      }

      body {
        min-height: 100vh;
        padding: 40px;
        color: #111111;
        background: #f7f7f8;
        font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Monaco, "Cascadia Mono",
          Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        line-height: 20px;
      }

      a {
        color: #0000ee;
      }

      a:visited {
        color: #551a8b;
      }

      @media (max-width: 600px) {
        body {
          padding: 20px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p>REDIRECTING: [Home](<a href={destination}>/</a>)</p>
    </main>
  </body>
</html>
