---
import { inquiryEmailAddress, inquiryEmailUrl } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Opening your email client for a Modern Faber inquiry."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content="Enter | Modern Faber" />
    <meta property="og:description" content="Opening your email client for a Modern Faber inquiry." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Modern Faber" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Enter | Modern Faber" />
    <meta name="twitter:description" content="Opening your email client for a Modern Faber inquiry." />
    <title>Enter | Modern Faber</title>
    <meta http-equiv="refresh" content={`0;url=${inquiryEmailUrl}`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #ffffff;
        --ink: #1a1a1a;
        --muted: #666666;
        --rule: #eeeeee;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-serif: "Instrument Serif", serif;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        margin: 0;
        min-height: 100vh;
        max-width: 540px;
        padding: 2rem 1rem 3rem;
        margin: 0 auto;
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.6;
        background: var(--bg);
      }

      main {
        display: grid;
        gap: 1.25rem;
      }

      a {
        color: inherit;
      }

      .brand {
        font-family: var(--font-serif);
        font-size: clamp(2.4rem, 8vw, 3.35rem);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 0.94;
        text-decoration: none;
      }

      .eyebrow,
      p,
      .cta {
        font-family: var(--font-mono);
      }

      .eyebrow {
        color: var(--muted);
        font-size: 0.74rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(2.7rem, 12vw, 4rem);
        font-weight: 400;
        letter-spacing: -0.03em;
        line-height: 0.92;
      }

      .rule {
        height: 1px;
        background: var(--rule);
      }

      .body {
        display: grid;
        gap: 1rem;
      }

      p {
        color: var(--muted);
        font-size: 0.82rem;
        line-height: 1.85;
        letter-spacing: 0.02em;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        padding: 0.4rem 0.75rem;
        background: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        box-shadow: 0 2px 0 #c0c0c0;
        color: #333333;
        text-decoration: none;
        font-size: 0.8rem;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
      }

      .cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 0 #c0c0c0;
      }

      .cta:active {
        transform: translateY(2px);
        box-shadow: 0 0 0 #c0c0c0;
      }
    </style>
    <script define:vars={{ inquiryEmailUrl }}>
      window.location.href = inquiryEmailUrl;
    </script>
  </head>
  <body>
    <main>
      <a class="brand" href="/">Modern Faber</a>
      <p class="eyebrow">Modern Faber</p>
      <h1>Opening your email client</h1>
      <div class="rule" aria-hidden="true"></div>
      <div class="body">
        <p>
          If your email client does not open automatically, use the link below and send a brief
          inquiry with recent work.
        </p>
        <a class="cta" href={inquiryEmailUrl}>Email {inquiryEmailAddress}</a>
      </div>
    </main>
  </body>
</html>
