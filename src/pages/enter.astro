---
import { inquiryEmailAddress, inquiryEmailUrl } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Opening your email client for a Modern Faber inquiry."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f7f8" />
    <title>Enter | Modern Faber</title>
    <meta http-equiv="refresh" content={`0;url=${inquiryEmailUrl}`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: #f7f7f8;
      }

      body {
        min-height: 100vh;
        padding: 40px;
        color: #111111;
        background: #f7f7f8;
        font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Monaco, "Cascadia Mono",
          Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        line-height: 20px;
      }

      main {
        display: grid;
        gap: 20px;
        justify-items: start;
      }

      h1 {
        font-size: inherit;
        font-weight: 400;
      }

      a {
        color: #0000ee;
      }

      a:visited {
        color: #551a8b;
      }

      @media (max-width: 600px) {
        body {
          padding: 20px;
        }
      }
    </style>
    <script define:vars={{ inquiryEmailUrl }}>
      window.location.href = inquiryEmailUrl;
    </script>
  </head>
  <body>
    <main>
      <h1>MODERN FABER</h1>
      <p aria-hidden="true">* * *</p>
      <p>OPENING YOUR EMAIL CLIENT...</p>
      <p>
        If nothing happens:<br />
        &nbsp;- [Email](<a href={inquiryEmailUrl}>{inquiryEmailAddress}</a>)
      </p>
    </main>
  </body>
</html>
