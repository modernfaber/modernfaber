<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Join | Modern Faber</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap");

      :root {
        --background: #ffffff;
        --text: #111111;
        --button: #111111;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 32px 20px;
        background: var(--background);
        color: var(--text);
        font-family: "IBM Plex Mono", monospace;
      }

      main {
        width: min(100%, 520px);
        text-align: center;
      }

      h1 {
        margin: 0 0 16px;
        font-size: clamp(1.9rem, 5vw, 3rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.05em;
      }

      p {
        margin: 0;
        line-height: 1.6;
      }

      a {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        margin-top: 24px;
        min-width: 120px;
        min-height: 48px;
        padding: 14px 20px;
        border: 1px solid var(--button);
        color: #ffffff;
        background: var(--button);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background 180ms ease, color 180ms ease;
      }

      a:hover,
      a:focus-visible {
        background: #ffffff;
        color: #111111;
      }

      a:focus-visible {
        outline: 2px solid rgba(17, 17, 17, 0.3);
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>You’re in.</h1>
      <p>This page is just a placeholder target for the landing screen’s join button.</p>
      <a href="/">Back</a>
    </main>
  </body>
</html>
